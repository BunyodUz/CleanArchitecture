{
  "realm": "cleanarchitecture",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "roles": {
    "realm": [
      {
        "name": "Administrator",
        "description": "Starting role with every permission. Protected: it can't be edited or deleted, and the last enabled user holding it can't lose it. Rename it freely.",
        "composite": true,
        "attributes": { "protected": ["true"] },
        "composites": {
          "client": {
            "cleanarchitecture-web": [
              "todolists.read", "todolists.write", "todoitems.read", "todoitems.write",
              "users.read", "users.write", "roles.read", "roles.write", "audit.read"
            ]
          }
        }
      },
      {
        "name": "Member",
        "description": "Sample role for the template's todo feature. Replace it with your own roles.",
        "composite": true,
        "composites": {
          "client": {
            "cleanarchitecture-web": ["todolists.read", "todolists.write", "todoitems.read", "todoitems.write"]
          }
        }
      }
    ],
    "client": {
      "cleanarchitecture-web": [
        { "name": "todolists.read", "description": "Read todo lists" },
        { "name": "todolists.write", "description": "Create/update/delete todo lists" },
        { "name": "todoitems.read", "description": "Read todo items" },
        { "name": "todoitems.write", "description": "Create/update/delete todo items" },
        { "name": "users.read", "description": "View users" },
        { "name": "users.write", "description": "Create/update/delete users and reset passwords" },
        { "name": "roles.read", "description": "View roles and their permissions" },
        { "name": "roles.write", "description": "Create/update/delete roles and assign roles to users" },
        { "name": "audit.read", "description": "View the audit log of changes to users and roles" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "cleanarchitecture-web",
      "name": "CleanArchitecture Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5000/signin-oidc",
        "https://localhost:5001/signin-oidc"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5000/signout-callback-oidc##https://localhost:5001/signout-callback-oidc"
      },
      "protocolMappers": [
        {
          "name": "realm roles (id token)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "permissions (id token)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "usermodel.clientRoleMapping.clientId": "cleanarchitecture-web",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cleanarchitecture-admin-api",
      "name": "CleanArchitecture Admin API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-admin-api-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "administrator",
      "email": "administrator@localhost",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Administrator1!", "temporary": false }
      ],
      "realmRoles": ["Administrator"]
    },
    {
      "username": "member",
      "email": "member@localhost",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "Member1!", "temporary": false }
      ],
      "realmRoles": ["Member"]
    },
    {
      "username": "service-account-cleanarchitecture-admin-api",
      "enabled": true,
      "serviceAccountClientId": "cleanarchitecture-admin-api",
      "clientRoles": {
        "realm-management": [
          "view-realm", "manage-realm",
          "view-users", "query-users", "query-groups", "manage-users",
          "view-clients", "query-clients", "manage-clients"
        ]
      }
    }
  ]
}
